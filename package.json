{
  "name": "horoi",
  "version": "1.1.0",
  "private": true,
  "description": "Tokenized Stock DeFi Conformance Infrastructure for BNB Smart Chain",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "api": "bun backend/api.ts",
    "web": "bun run --cwd frontend dev",
    "cli": "bun backend/cli.ts",
    "smoke:fork": "bun backend/scripts/fork-harness-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "bun test backend/tests",
    "build": "bun build backend/cli.ts --compile --outfile dist/horoi && bun run --cwd frontend build",
    "contract:test": "forge test",
    "contract:fmt": "forge fmt --check",
    "verify": "bun run typecheck && bun run test && bun run contract:test && bun run --cwd frontend build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@sinclair/typebox": "0.34.52",
    "@vercel/sandbox": "3.5.0",
    "elysia": "1.4.30",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
