# BSC mainnet RPC (no credentials in committed files)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Horoi API
PORT=3000
DATABASE_PATH=./horoi.db
REGISTRY_ADDRESS=
MAX_CONCURRENT_RUNS=2

# Optional fork discovery overrides (never private keys)
HOROI_HOLDER_ADDRESS=
HOROI_MULTIPLIER_UPDATER=

# Binance Web3 API (server-side only; both values required for signed calls)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build

# Deploy only — never commit a real key
# PRIVATE_KEY=
# BSCSCAN_API_KEY=
